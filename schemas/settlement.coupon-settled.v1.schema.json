{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "CouponSettledV1",
  "type": "object",
  "description": "Stage two: the coupon's settlement at SettlementVersion. A result correction produces a higher version;\npayout moves only the difference between TargetPayout and what it has already paid.",
  "additionalProperties": false,
  "required": [
    "couponId",
    "punterId",
    "settlementVersion",
    "outcome",
    "stake",
    "effectiveOdds",
    "targetPayout",
    "settledAt"
  ],
  "properties": {
    "couponId": {
      "type": "string",
      "format": "guid"
    },
    "punterId": {
      "type": "string",
      "format": "guid"
    },
    "settlementVersion": {
      "type": "integer",
      "format": "int32"
    },
    "outcome": {
      "$ref": "#/definitions/CouponOutcome"
    },
    "stake": {
      "$ref": "#/definitions/Money"
    },
    "effectiveOdds": {
      "type": "number",
      "format": "decimal"
    },
    "targetPayout": {
      "$ref": "#/definitions/Money"
    },
    "settledAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "CouponOutcome": {
      "type": "string",
      "description": "",
      "x-enumNames": [
        "Won",
        "Lost",
        "Void"
      ],
      "enum": [
        "won",
        "lost",
        "void"
      ]
    },
    "Money": {
      "type": "object",
      "description": "An amount in minor units (cents) of an ISO 4217 currency.",
      "additionalProperties": false,
      "required": [
        "minorUnits",
        "currency"
      ],
      "properties": {
        "minorUnits": {
          "type": "integer",
          "format": "int64"
        },
        "currency": {
          "type": "string"
        }
      }
    }
  }
}
