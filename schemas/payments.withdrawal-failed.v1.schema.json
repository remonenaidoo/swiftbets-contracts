{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "WithdrawalFailedV1",
  "type": "object",
  "description": "A withdrawal ended without paying out (provider failure or rejection); the hold went back to the customer.",
  "additionalProperties": false,
  "required": [
    "withdrawalId",
    "userId",
    "amount",
    "reason",
    "failedAt"
  ],
  "properties": {
    "withdrawalId": {
      "type": "string",
      "format": "guid"
    },
    "userId": {
      "type": "string",
      "format": "guid"
    },
    "amount": {
      "$ref": "#/definitions/Money"
    },
    "reason": {
      "type": "string"
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "Money": {
      "type": "object",
      "description": "An amount in minor units (cents) of an ISO 4217 currency.",
      "additionalProperties": false,
      "required": [
        "minorUnits",
        "currency"
      ],
      "properties": {
        "minorUnits": {
          "type": "integer",
          "format": "int64"
        },
        "currency": {
          "type": "string"
        }
      }
    }
  }
}
